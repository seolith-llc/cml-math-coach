{
  "name": "cml-math-coach",
  "version": "0.1.0",
  "private": true,
  "description": "Voice-first PWA for practicing Continental Math League problems, Grades 2–3.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
